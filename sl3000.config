# 核心架构定义
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_mt7981-sl3000-emmc=y

# 🎯 物理对齐：禁止编译其他干扰设备，防止 FIP 报错熔断
CONFIG_TARGET_MULTI_PROFILE=n
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_immortalwrt_mediatek-filogic-openwrt_one=n
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_mediatek_mt7981-rfb=n

# 🚀 [物理硬修复] 磁盘分区锁定 (128MB Kernel / 1024MB Rootfs)
CONFIG_TARGET_KERNEL_PARTSIZE=128
CONFIG_TARGET_ROOTFS_PARTSIZE=1024
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_IMAGES_GZIP=y

# 引导程序核心组件
CONFIG_PACKAGE_arm-trusted-firmware-mediatek=y
CONFIG_ARM_TRUSTED_FIRMWARE_MEDIATEK_mt7981-emmc-ddr3=y
CONFIG_PACKAGE_uboot-mediatek-mt7981-sl3000-emmc=y

# 核心硬件驱动 (物理对应 eMMC & f2fs)
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-sdhci-mtk=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y

# 基础应用层
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y

# 物理补充：为了防止 FIP Error 1 必须锁定的辅助包
CONFIG_PACKAGE_fiptool=y
CONFIG_PACKAGE_mksandimage=y
