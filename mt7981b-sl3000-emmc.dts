/dts-v1/;

/* 🎯 只保留最基础的系统级头文件，这些在所有内核版本中路径都是固定的 */
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
    interrupt-parent = <&gic>;
    #address-cells = <2>;
    #size-cells = <2>;

    model = "SL-3000 eMMC Router (128GB Custom Edition)";
    compatible = "sl,sl3000-emmc", "mediatek,mt7981";

    /* 🎯 1GB RAM 强行锁定 */
    memory@40000000 {
        device_type = "memory";
        reg = <0 0x40000000 0 0x40000000>;
    };

    chosen {
        bootargs = "console=ttyS0,115200n8 earlycon=uart8250,mmio32,0x11002000";
        stdout-path = "serial0:115200n8";
    };

    cpus {
        #address-cells = <1>;
        #size-cells = <0>;
        cpu0: cpu@0 {
            device_type = "cpu";
            compatible = "arm,cortex-a53";
            reg = <0>;
            enable-method = "psci";
        };
        cpu1: cpu@1 {
            device_type = "cpu";
            compatible = "arm,cortex-a53";
            reg = <1>;
            enable-method = "psci";
        };
    };

    psci {
        compatible = "arm,psci-0.2";
        method = "smc";
    };

    /* 🎯 内部基础总线定义 (原本在 mt7981.dtsi 中，现在物理合入) */
    soc {
        #address-cells = <1>;
        #size-cells = <1>;
        compatible = "simple-bus";
        ranges = <0 0 0 0x40000000>;

        gic: interrupt-controller@0c000000 {
            compatible = "arm,gic-v3";
            #interrupt-cells = <3>;
            interrupt-controller;
            reg = <0x0c000000 0x40000>,
                  <0x0c080000 0x200000>;
        };

        pio: pinctrl@11d00000 {
            compatible = "mediatek,mt7981-pinctrl";
            reg = <0x11d00000 0x1000>;
            gpio-controller;
            #gpio-cells = <2>;
        };

        uart0: serial@11002000 {
            compatible = "mediatek,mt7981-uart", "ns16550a";
            reg = <0x11002000 0x400>;
            interrupts = <0 52 4>;
            clocks = <&uart_clk>;
            status = "disabled";
        };

        mmc0: mmc@11230000 {
            compatible = "mediatek,mt7981-mmc";
            reg = <0x11230000 0x1000>, <0x11c20000 0x1000>;
            interrupts = <0 143 4>;
            status = "disabled";
        };

        watchdog: watchdog@10007000 {
            compatible = "mediatek,mt7981-wdt";
            reg = <0x10007000 0x100>;
        };
    };

    /* 时钟源模拟 */
    uart_clk: dummy-clk {
        compatible = "fixed-clock";
        #clock-cells = <0>;
        clock-frequency = <40000000>;
    };

    /* 🎯 你的自定义配置：按键/LED */
    gpio-keys {
        compatible = "gpio-keys";
        reset {
            label = "reset";
            gpios = <&pio 1 GPIO_ACTIVE_LOW>;
            linux,code = <KEY_RESTART>;
        };
    };

    gpio-leds {
        compatible = "gpio-leds";
        status_blue {
            label = "blue:status";
            gpios = <&pio 8 GPIO_ACTIVE_HIGH>;
        };
    };

    reg_3p3v: regulator-3p3v {
        compatible = "regulator-fixed";
        regulator-name = "fixed-3.3V";
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        regulator-boot-on;
        regulator-always-on;
    };
};

/* 🎯 引用块：由于基础内容已合入上面，这里的 & 引用将直接生效 */
&mmc0 {
    pinctrl-names = "default", "state_uhs";
    pinctrl-0 = <&mmc0_pins_default>;
    pinctrl-1 = <&mmc0_pins_uhs>;
    bus-width = <8>;
    max-frequency = <200000000>;
    cap-mmc-highspeed;
    mmc-hs200-1_8v;
    mmc-hs400-1_8v;
    non-removable;
    vmmc-supply = <&reg_3p3v>;
    status = "okay";

    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        partition@0 { label = "gpt"; reg = <0x0 0x100000>; read-only; };
        partition@100000 { label = "u-boot-env"; reg = <0x100000 0x80000>; };
        partition@180000 { label = "factory"; reg = <0x180000 0x200000>; read-only; };

        /* 🎯 128MB Factory 逻辑 */
        partition@380000 {
            label = "kernel";
            reg = <0x380000 0x8000000>;
        };

        partition@8380000 {
            label = "rootfs";
            reg = <0x8380000 0x40000000>;
        };
    };
};

&pio {
    mmc0_pins_default: mmc0-pins-default {
        mux { function = "flash"; groups = "emmc_51"; };
        conf-cmd-dat {
            pins = "EMMC_DATA0", "EMMC_DATA1", "EMMC_DATA2", "EMMC_DATA3",
                   "EMMC_DATA4", "EMMC_DATA5", "EMMC_DATA6", "EMMC_DATA7", "EMMC_CMD";
            input-enable;
            drive-strength = <4>;
            bias-pull-up = <1>;
        };
        conf-clk {
            pins = "EMMC_CK";
            drive-strength = <6>;
            bias-pull-down = <2>;
        };
        conf-rst {
            pins = "EMMC_RSTB";
            drive-strength = <4>;
            bias-pull-up = <1>;
        };
    };

    mmc0_pins_uhs: mmc0-pins-uhs {
        mux { function = "flash"; groups = "emmc_51"; };
        conf-cmd-dat {
            pins = "EMMC_DATA0", "EMMC_DATA1", "EMMC_DATA2", "EMMC_DATA3",
                   "EMMC_DATA4", "EMMC_DATA5", "EMMC_DATA6", "EMMC_DATA7", "EMMC_CMD";
            input-enable;
            drive-strength = <4>;
            bias-pull-up = <1>;
        };
    };

    uart0_pins: uart0-pins {
        mux { function = "uart"; groups = "uart0_0_tx_rx"; };
    };
};

&uart0 {
    pinctrl-names = "default";
    pinctrl-0 = <&uart0_pins>;
    status = "okay";
};

&watchdog { status = "okay"; };
